{
  "manifest_version": 3,
  "name": "드라이브 영상 갤러리 도우미",
  "version": "1.7",
  "description": "드라이브 영상 갤러리에서 공유 허용 없이 플레이어 화면을 바로 캡처하고(컨트롤 자동 숨김), 재생·프레임 이동 버튼과 수정 모드 자동 멈춤을 쓸 수 있게 합니다.",
  "background": { "service_worker": "relay.js" },
  "content_scripts": [
    {
      "matches": ["https://srsplitter.github.io/drive-gallery/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["autopause.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
